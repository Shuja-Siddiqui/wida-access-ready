# Copy this file to .env and fill in the values.
# These are read by the SSR server and Vite. Defaults also exist in code.

NODE_ENV=development
PORT=3000
BASE_PATH=/

# API server used for SSR fetches and the Vite /api proxy.
# Local:
INTERNAL_PROXY_BASE_URL=http://localhost:8080
# EC2 (goelprep-server):
# INTERNAL_PROXY_BASE_URL=http://50.19.228.178:8080
